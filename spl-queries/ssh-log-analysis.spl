# SSH Log Analysis using Splunk
# SPL Queries

# ============================================================
# Task 1 - Ingest and Parse Logs
# ============================================================

# Validate SSH events by event type
index=ssh_log
| stats count by event_type


# ============================================================
# Task 2 - Analyze Failed Login Attempts
# ============================================================

# Failed login attempts by source IP
index=ssh_logs event_type="Failed SSH Login"
| stats count by id.orig_h


# ============================================================
# Task 3 - Detect Multiple Failed Authentication Attempts
# ============================================================

# Multiple failed authentication attempts by source and destination
index=ssh_logs event_type="Multiple Failed Authentication Attempts"
| stats count by id.orig_h, id.resp_h


# ============================================================
# Task 4 - Track Successful Logins
# ============================================================

# Successful logins by source and destination
index=ssh_logs event_type="Successful SSH Login"
| stats count by id.orig_h, id.resp_h


# ============================================================
# Task 5 - Suspicious Connections Without Authentication
# ============================================================

# Unauthenticated SSH connections
index=ssh_logs event_type="Connection Without Authentication"
| stats count by id.orig_h


# Unauthenticated connections over time
index=ssh_logs event_type="Connection Without Authentication"
| timechart count by id.orig_h
